[TEMPLATE]
# Copy to .env and adjust. Relative paths resolve against the repo root.
DATA_RAW_DIR=../../data/raw
DATA_PROCESSED_DIR=../../data/processed

# ---------------------------------------------------------------------------
# AIS Data Feed Configuration
# ---------------------------------------------------------------------------
# Option 1: AISHub (free real-time API, register at https://www.aishub.net)
#AIS_FEED_URL=https://data.aishub.net/ws.php?username=YOUR_USERNAME&format=1&output=json&compress=0
#AIS_API_KEY=

# Option 2: MarineTraffic (commercial API, requires subscription)
#AIS_FEED_URL=https://www.marinetraffic.com/api/getVesselsNear?lat=10.5&lon=10.5&distance=50&ApiKey=YOUR_KEY
#AIS_API_KEY=YOUR_KEY

# Option 3: Custom NMEA TCP/HTTP stream (e.g. local AIS receiver, SignalK, ShipPlotter)
#AIS_FEED_URL=http://localhost:4000/nmea

# Option 4: Leave empty to use synthetic simulation (demo mode)
AIS_FEED_URL=

# Feed settings
AIS_POLL_INTERVAL_SEC=10
AIS_REQUEST_TIMEOUT_SEC=30
AIS_CIRCUIT_BREAKER_THRESHOLD=3
AIS_CIRCUIT_BREAKER_RESET_SEC=60
AIS_FALLBACK_TO_SIMULATION=true

# ---------------------------------------------------------------------------
# Detection
# ---------------------------------------------------------------------------
DETECTION_THRESHOLD=0.5
DETECTION_INPUT_SIZE=512
MODEL_BACKBONE=resnet34

# ---------------------------------------------------------------------------
# AIS anomaly detection thresholds
# ---------------------------------------------------------------------------
AIS_MAX_SPEED_KNOTS=60
AIS_MAX_POSITION_JUMP_KM=100
AIS_SPOOF_SCORE_THRESHOLD=0.7

# ---------------------------------------------------------------------------
# Attribution
# ---------------------------------------------------------------------------
ATTRIBUTION_SEARCH_RADIUS_KM=10
ATTRIBUTION_WINDOW_HOURS=6
