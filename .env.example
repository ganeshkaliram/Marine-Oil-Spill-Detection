# Copy to .env and adjust. Relative paths resolve against the repo root.
DATA_RAW_DIR=../../data/raw
DATA_PROCESSED_DIR=../../data/processed

# Detection
DETECTION_THRESHOLD=0.5
DETECTION_INPUT_SIZE=512
MODEL_BACKBONE=resnet34

# AIS anomaly detection
AIS_MAX_SPEED_KNOTS=60
AIS_MAX_POSITION_JUMP_KM=100
AIS_SPOOF_SCORE_THRESHOLD=0.7

# Attribution
ATTRIBUTION_SEARCH_RADIUS_KM=10
ATTRIBUTION_WINDOW_HOURS=6
